{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {},
  "extensions": [
    {
      "name": "location-billable-services-link",
      "slot": "billable-services-left-panel-slot",
      "component": "locationBillableServicesLink",
      "meta": {
        "slot": "location-billable-services-dashboard-slot",
        "path": "fbs",
        "layoutMode": "anchored"
      },
      "online": true,
      "offline": true
    },
    {
      "name": "location-billable-services",
      "slot": "location-billable-services-dashboard-slot",
      "component": "billableServicesAdminRoot",
      "order": 1,
      "online": true,
      "offline": true
    }
  ],
  "pages": [
    {
      "component": "root",
      "route": "billing-admin"
    },
    {
      "component": "billableServicesAdminRoot",
      "route": "fbs"
    },
    {
      "component": "billableDrugsAdminRoot",
      "route": "billable-drugs-admin"
    }
  ]
